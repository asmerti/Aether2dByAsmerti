    /**
     * 9. REAL-TIME OSCILLOSCOPE PROFILER
     */
    class TelemetryProfiler {
      constructor(canvasId) {
        this.canvas = document.getElementById(canvasId);
        this.ctx = this.canvas.getContext('2d');
        this.maxSamples = 147;
        this.physHistory = new Float32Array(this.maxSamples);
        this.renderHistory = new Float32Array(this.maxSamples);
        this.head = 0;

        this.fpsFrames = 0;
        this.fpsLastTime = performance.now();
        this.currentFps = 60;
      }

      record(physMs, renderMs) {
        this.physHistory[this.head] = physMs;
        this.renderHistory[this.head] = renderMs;
        this.head = (this.head + 1) % this.maxSamples;

        this.fpsFrames++;
        const now = performance.now();
        if (now - this.fpsLastTime >= 350) {
          this.currentFps = Math.round((this.fpsFrames * 1000) / (now - this.fpsLastTime));
          this.fpsFrames = 0;
          this.fpsLastTime = now;
        }
      }

      draw(world) {
        const ctx = this.ctx;
        const w = this.canvas.width;
        const h = this.canvas.height;

        ctx.clearRect(0, 0, w, h);

        ctx.strokeStyle = 'rgba(30, 41, 59, 0.55)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, h * 0.5);
        ctx.lineTo(w, h * 0.5);
        ctx.stroke();

        const maxScaleMs = 22.0;
        const budgetY = h - (16.67 / maxScaleMs) * h;
        ctx.strokeStyle = 'rgba(244, 63, 94, 0.45)';
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(0, budgetY);
        ctx.lineTo(w, budgetY);
        ctx.stroke();
        ctx.setLineDash([]);

        const stepX = w / (this.maxSamples - 1);

        ctx.strokeStyle = '#f59e0b';
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        for (let i = 0; i < this.maxSamples; i++) {
          const idx = (this.head + i) % this.maxSamples;
          const totalMs = this.physHistory[idx] + this.renderHistory[idx];
          const x = i * stepX;
          const y = h - Math.min(1, totalMs / maxScaleMs) * (h - 6) - 2;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();

        ctx.strokeStyle = '#00f0ff';
        ctx.fillStyle = 'rgba(0, 240, 255, 0.14)';
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        for (let i = 0; i < this.maxSamples; i++) {
          const idx = (this.head + i) % this.maxSamples;
          const pMs = this.physHistory[idx];
          const x = i * stepX;
          const y = h - Math.min(1, pMs / maxScaleMs) * (h - 6) - 2;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
        ctx.lineTo(w, h);
        ctx.lineTo(0, h);
        ctx.closePath();
        ctx.fill();

        const fpsEl = document.getElementById('hud-fps');
        fpsEl.textContent = `${this.currentFps} FPS`;
        fpsEl.className =
          this.currentFps >= 50
            ? 'font-mono text-xs font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30'
            : this.currentFps >= 30
            ? 'font-mono text-xs font-bold px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30'
            : 'font-mono text-xs font-bold px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30';

        document.getElementById('stat-bodies').textContent = world.particles.length.toLocaleString();
        document.getElementById('stat-constraints').textContent = world.constraints.length.toLocaleString();
        document.getElementById('stat-broadphase').textContent = world.metrics.broadphaseChecks.toLocaleString();
        document.getElementById('stat-contacts').textContent = world.metrics.narrowphaseContacts.toLocaleString();
        document.getElementById('stat-phys-ms').textContent = `${world.metrics.physicsStepMs.toFixed(2)} ms`;
      }
    }

    /**
     * 10. MAIN MENU INTERACTIVE PHYSICS BACKGROUND ANIMATION
     */
    const MenuBackgroundSim = {
      canvas: null,
      ctx: null,
      nodes: [],
      links: [],
      mouseX: -1000,
      mouseY: -1000,
      active: true,

      init() {
        this.canvas = document.getElementById('menu-bg-canvas');
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        this.resize();
        window.addEventListener('resize', () => this.resize());
        window.addEventListener('pointermove', (e) => {
          this.mouseX = e.clientX;
          this.mouseY = e.clientY;
        });
        this._populate();
      },

      resize() {
        if (!this.canvas) return;
        this.canvas.width = window.innerWidth;
        this.canvas.height = window.innerHeight;
      },

      _populate() {
        this.nodes.length = 0;
        this.links.length = 0;
        const w = window.innerWidth || 1280;
        const h = window.innerHeight || 720;
        const count = 58;

        for (let i = 0; i < count; i++) {
          this.nodes.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 1.3,
            vy: (Math.random() - 0.5) * 1.3,
            r: 2.2 + (i % 3) * 1.4,
            color: i % 4 === 0 ? '#00f0ff' : i % 4 === 1 ? '#10b981' : '#38bdf8'
          });
        }
      },

      stepAndDraw() {
        if (!this.active || !this.ctx) return;
        const ctx = this.ctx;
        const w = this.canvas.width;
        const h = this.canvas.height;

        ctx.clearRect(0, 0, w, h);

        // Subtle grid
        ctx.strokeStyle = 'rgba(30, 41, 59, 0.25)';
        ctx.lineWidth = 1;
        const gs = 64;
        ctx.beginPath();
        for (let x = 0; x < w; x += gs) {
          ctx.moveTo(x, 0);
          ctx.lineTo(x, h);
        }
        for (let y = 0; y < h; y += gs) {
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
        }
        ctx.stroke();

        // Update nodes & draw cyber constellation
        for (let i = 0; i < this.nodes.length; i++) {
          const n = this.nodes[i];
          n.x += n.vx;
          n.y += n.vy;

          if (n.x < 0 || n.x > w) n.vx *= -1;
          if (n.y < 0 || n.y > h) n.vy *= -1;

          // Repel gently from mouse
          const dx = n.x - this.mouseX;
          const dy = n.y - this.mouseY;
          const dSq = dx * dx + dy * dy;
          if (dSq < 26000 && dSq > 1) {
            const d = Math.sqrt(dSq);
            n.x += (dx / d) * 2.2;
            n.y += (dy / d) * 2.2;
          }

          for (let j = i + 1; j < this.nodes.length; j++) {
            const m = this.nodes[j];
            const lx = m.x - n.x;
            const ly = m.y - n.y;
            const distSq = lx * lx + ly * ly;
            if (distSq < 24000) {
              const alpha = (1 - distSq / 24000) * 0.35;
              ctx.strokeStyle = `rgba(0, 240, 255, ${alpha})`;
              ctx.lineWidth = 1.2;
              ctx.beginPath();
              ctx.moveTo(n.x, n.y);
              ctx.lineTo(m.x, m.y);
              ctx.stroke();
            }
          }

          ctx.fillStyle = n.color;
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    };

    /**
     * 11. MAIN APPLICATION CONTROLLER, RENDERER & PORTABLE HTML EXPORTER
     */
    const EngineApp = {
      canvas: null,
      ctx: null,
      world: null,
      profiler: null,
      currentScenario: 'ragdoll',
      isPaused: false,
      isSlowMo: false,
      spawnType: 'ragdoll', // 'ragdoll' | 'bomb' | 'rock'

      fixedDt: 1 / 60,
      accumulator: 0,
      lastFrameTime: 0,

      pointer: {
        x: 0,
        y: 0,
        prevX: 0,
        prevY: 0,
        startX: 0,
        startY: 0,
        isDown: false,
        button: 0,
        shiftKey: false,
        tool: 'grab', // 'grab' | 'slice' | 'cannon' | 'vortex' | 'grinder' | 'welder' | 'spawner'
        grabbedParticle: null,
        weldStartNode: null
      },

      init() {
        MenuBackgroundSim.init();

        this.canvas = document.getElementById('sim-canvas');
        this.ctx = this.canvas.getContext('2d');
        this.profiler = new TelemetryProfiler('profiler-canvas');

        const rect = this.canvas.parentElement.getBoundingClientRect();
        this.canvas.width = rect.width || window.innerWidth - 320;
        this.canvas.height = rect.height || window.innerHeight - 56;

        this.world = new AetherPhysicsWorld(this.canvas.width, this.canvas.height);

        this._bindEvents();
        this.loadScenario('ragdoll');

        this.lastFrameTime = performance.now();
        requestAnimationFrame((ts) => this._gameLoop(ts));
      },

      enterSandbox() {
        const overlay = document.getElementById('main-menu-overlay');
        if (overlay) overlay.classList.add('hidden-overlay');
        MenuBackgroundSim.active = false;
        this.loadScenario('ragdoll');
      },

      showMainMenu() {
        const overlay = document.getElementById('main-menu-overlay');
        if (overlay) overlay.classList.remove('hidden-overlay');
        MenuBackgroundSim.active = true;
      },

      showToast(message) {
        const toast = document.getElementById('toast-notification');
        const msg = document.getElementById('toast-message');
        if (!toast || !msg) return;
        msg.textContent = message;
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        clearTimeout(this._toastTimer);
        this._toastTimer = setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(12px)';
        }, 3200);
      },

      /**
       * SERIALIZES & DOWNLOADS A 100% SELF-CONTAINED PORTABLE HTML FILE
       */
      downloadPortableHTML() {
        try {
          const clone = document.documentElement.cloneNode(true);
          const menuOverlay = clone.querySelector('#main-menu-overlay');
          if (menuOverlay) {
            menuOverlay.classList.remove('hidden-overlay');
          }
          const toast = clone.querySelector('#toast-notification');
          if (toast) {
            toast.style.opacity = '0';
          }

          const htmlContent = '<!DOCTYPE html>\n' + clone.outerHTML;
          const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
          const url = URL.createObjectURL(blob);

          const a = document.createElement('a');
          a.href = url;
          a.download = 'Aether2D_Physics_Sandbox.html';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 2000);

          this.showToast('✅ Aether2D_Physics_Sandbox.html descargado (Versión Portable)');
        } catch (err) {
          this.showToast('⚠️ Error al generar el archivo HTML portable');
        }
      },

      _bindEvents() {
        window.addEventListener('resize', () => {
          if (!this.canvas.parentElement) return;
          const rect = this.canvas.parentElement.getBoundingClientRect();
          this.canvas.width = rect.width;
          this.canvas.height = rect.height;
          this.world.width = rect.width;
          this.world.height = rect.height;
        });

        this.canvas.addEventListener('contextmenu', (e) => e.preventDefault());

        this.canvas.addEventListener('pointerdown', (e) => {
          const rect = this.canvas.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;

          this.pointer.x = x;
          this.pointer.y = y;
          this.pointer.prevX = x;
          this.pointer.prevY = y;
          this.pointer.startX = x;
          this.pointer.startY = y;
          this.pointer.isDown = true;
          this.pointer.button = e.button;
          this.pointer.shiftKey = e.shiftKey;

          // Universal Right-Click Quick Action: Radial Shockwave Explosion
          if (e.button === 2 && this.pointer.tool !== 'vortex') {
            this.world.detonateExplosion(x, y, 195, 22);
            return;
          }

          if (e.button !== 0) return;

          if (this.pointer.tool === 'grab') {
            this.pointer.grabbedParticle = this._findNearestParticle(x, y, 48);
          } else if (this.pointer.tool === 'welder') {
            let startNode = this._findNearestParticle(x, y, 36);
            if (!startNode) {
              startNode = this.world.addParticle(new Particle(x, y, 6, 0, true, '#00f0ff'));
            }
            this.pointer.weldStartNode = startNode;
          } else if (this.pointer.tool === 'spawner') {
            this._executeSpawnerAt(x, y);
          }
        });

        window.addEventListener('pointermove', (e) => {
          const rect = this.canvas.getBoundingClientRect();
          this.pointer.prevX = this.pointer.x;
          this.pointer.prevY = this.pointer.y;
          this.pointer.x = e.clientX - rect.left;
          this.pointer.y = e.clientY - rect.top;
          this.pointer.shiftKey = e.shiftKey;

          if (!this.pointer.isDown) return;

          if (this.pointer.tool === 'slice') {
            this.world.sliceConstraints(
              this.pointer.prevX,
              this.pointer.prevY,
              this.pointer.x,
              this.pointer.y
            );
          }
        });

        window.addEventListener('pointerup', () => {
          if (!this.pointer.isDown) return;

          // Tool 3: Cannon Ballistic Launch on Release
          if (this.pointer.tool === 'cannon' && this.pointer.button === 0 && !this.pointer.shiftKey) {
            const dx = this.pointer.startX - this.pointer.x;
            const dy = this.pointer.startY - this.pointer.y;
            const pullDist = Math.hypot(dx, dy);

            const vx = pullDist > 8 ? dx * 5.6 : 520;
            const vy = pullDist > 8 ? dy * 5.6 : -180;

            const proj = new Particle(this.pointer.startX, this.pointer.startY, 15, 16.0, false, '#f43f5e');
            proj.restitution = 0.75;
            proj.setVelocity(vx, vy, this.fixedDt / this.world.params.subSteps);
            this.world.addParticle(proj);
            this.world.spawnSparks(this.pointer.startX, this.pointer.startY, 14, '#f43f5e', 280);
          }

          // Tool 6: Rope & Spring Welder Completion
          if (this.pointer.tool === 'welder' && this.pointer.weldStartNode && this.pointer.button === 0) {
            const n1 = this.pointer.weldStartNode;
            let n2 = this._findNearestParticle(this.pointer.x, this.pointer.y, 38);
            if (!n2 || n2 === n1) {
              n2 = this.world.addParticle(new Particle(this.pointer.x, this.pointer.y, 6.5, 0, true, '#00f0ff'));
            }
            const dist = Math.max(12, Math.hypot(n2.x - n1.x, n2.y - n1.y));
            const weldLink = new DistanceConstraint(n1, n2, 0.82, dist, 3.8, true, '#f59e0b');
            this.world.addConstraint(weldLink);
            this.world.spawnSparks(n2.x, n2.y, 10, '#f59e0b', 220);
            this.pointer.weldStartNode = null;
          }

          this.pointer.isDown = false;
          this.pointer.grabbedParticle = null;
          this.pointer.weldStartNode = null;
        });

        // Keyboard Shortcuts (Including [E] / [Space] Pinning while Grabbing)
        window.addEventListener('keydown', (e) => {
          if (e.target.tagName === 'INPUT') return;

          // Pin/Unpin grabbed particle in mid-air with [E] or [Space]
          if ((e.key === 'e' || e.key === 'E' || e.code === 'Space') && this.pointer.grabbedParticle) {
            e.preventDefault();
            const gp = this.pointer.grabbedParticle;
            gp.setPinned(!gp.pinned);
            this.world.spawnSparks(gp.x, gp.y, 12, gp.pinned ? '#00f0ff' : '#f59e0b', 220);
            this.showToast(gp.pinned ? '📌 Extremidad/Nodo ANCLADO en el aire' : '🔓 Anclaje liberado');
            return;
          }

          if (e.key === 'p' || e.key === 'P') {
            this.togglePause();
          } else if (e.key === 'r' || e.key === 'R') {
            this.resetCurrentScenario();
          } else if (e.key === '1') {
            this.setTool('grab');
          } else if (e.key === '2') {
            this.setTool('slice');
          } else if (e.key === '3') {
            this.setTool('cannon');
          } else if (e.key === '4') {
            this.setTool('vortex');
          } else if (e.key === '5') {
            this.setTool('grinder');
          } else if (e.key === '6') {
            this.setTool('welder');
          } else if (e.key === '7') {
            this.setTool('spawner');
          }
        });
      },

      _executeSpawnerAt(x, y) {
        if (this.spawnType === 'ragdoll') {
          RagdollFactory.createHumanMannequin(this.world, x, y, 1.0, this.world.ragdollMode);
          this.world.spawnSparks(x, y, 16, '#00f0ff', 260);
        } else if (this.spawnType === 'bomb') {
          const bomb = new Particle(x, y, 15, 8.0, false, '#f43f5e');
          bomb.isBomb = true;
          bomb.bombTimer = 2.2; // Detonates in 2.2 seconds
          bomb.restitution = 0.6;
          this.world.addParticle(bomb);
          this.world.spawnSparks(x, y, 10, '#f59e0b', 180);
        } else if (this.spawnType === 'rock') {
          const rock = new Particle(x, y, 22, 26.0, false, '#f59e0b');
          rock.restitution = 0.35;
          this.world.addParticle(rock);
          this.world.spawnSparks(x, y, 10, '#94a3b8', 180);
        }
      },

      spawnExtraRagdoll() {
        const x = this.world.width * (0.35 + Math.random() * 0.3);
        const y = Math.max(110, this.world.height * 0.22);
        RagdollFactory.createHumanMannequin(this.world, x, y, 1.05, this.world.ragdollMode);
        this.world.spawnSparks(x, y, 18, '#00f0ff', 280);
        this.showToast('🧍 Nuevo Maniquí Humano desplegado en el laboratorio');
      },

      unpinAllNodes() {
        let count = 0;
        for (let i = 0; i < this.world.particles.length; i++) {
          const p = this.world.particles[i];
          if (p.pinned && p.ragdollId) {
            p.setPinned(false);
            count++;
          }
        }
        this.showToast(`🔓 ${count} anclajes del maniquí liberados`);
      },

      _findNearestParticle(x, y, maxDist) {
        let best = null;
        let bestDistSq = maxDist * maxDist;
        const particles = this.world.particles;
        for (let i = 0; i < particles.length; i++) {
          const p = particles[i];
          const dx = p.x - x;
          const dy = p.y - y;
          const dSq = dx * dx + dy * dy;
          if (dSq < bestDistSq) {
            bestDistSq = dSq;
            best = p;
          }
        }
        return best;
      },

      _gameLoop(timestamp) {
        let frameDelta = (timestamp - this.lastFrameTime) / 1000;
        this.lastFrameTime = timestamp;
        if (frameDelta > 0.1) frameDelta = 0.1;

        if (MenuBackgroundSim.active) {
          MenuBackgroundSim.stepAndDraw();
        }

        if (!this.isPaused) {
          this.accumulator += frameDelta;

          // Machine-gun stream when holding Shift in Cannon tool
          if (this.pointer.isDown && this.pointer.tool === 'cannon' && this.pointer.shiftKey) {
            const p = new Particle(
              this.pointer.x + (Math.random() - 0.5) * 6,
              this.pointer.y + (Math.random() - 0.5) * 6,
              6.5,
              2.5,
              false,
              '#00f0ff'
            );
            p.setVelocity(520 + (Math.random() - 0.5) * 90, -140 + (Math.random() - 0.5) * 90, this.fixedDt / this.world.params.subSteps);
            this.world.addParticle(p);
          }

          while (this.accumulator >= this.fixedDt) {
            this.world.step(this.fixedDt, this.pointer);
            this.accumulator -= this.fixedDt;
          }
        }

        const r0 = performance.now();
        this._render();
        this.world.metrics.renderMs = performance.now() - r0;

        this.profiler.record(this.world.metrics.physicsStepMs, this.world.metrics.renderMs);
        this.profiler.draw(this.world);

        requestAnimationFrame((ts) => this._gameLoop(ts));
      },

      /**
       * MAIN RENDERER (RAGDOLL ANATOMICAL CAPSULES, HEATMAP, TOOLS & FX)
       */
      _render() {
        const ctx = this.ctx;
        const w = this.canvas.width;
        const h = this.canvas.height;
        const world = this.world;

        ctx.clearRect(0, 0, w, h);

        // 1. Blueprint Engineering Grid
        ctx.strokeStyle = 'rgba(30, 41, 59, 0.26)';
        ctx.lineWidth = 1;
        const bgStep = 48;
        ctx.beginPath();
        for (let x = 0; x < w; x += bgStep) {
          ctx.moveTo(x, 0);
          ctx.lineTo(x, h);
        }
        for (let y = 0; y < h; y += bgStep) {
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
        }
        ctx.stroke();

        // 2. Active Spatial Hash Grid Overlay
        if (world.debug.showGrid && world.broadphaseMode === 'grid') {
          const buckets = world.spatialGrid.activeBuckets;
          const cs = world.spatialGrid.cellSize;

          for (let i = 0; i < buckets.length; i++) {
            const b = buckets[i];
            const count = b.items.length;
            if (count === 0) continue;

            const density = Math.min(1, count / 8);
            const x = b.cx * cs;
            const y = b.cy * cs;

            ctx.fillStyle =
              count > 5
                ? `rgba(245, 158, 11, ${0.08 + density * 0.22})`
                : `rgba(0, 240, 255, ${0.04 + density * 0.16})`;
            ctx.strokeStyle =
              count > 5
                ? 'rgba(245, 158, 11, 0.35)'
                : 'rgba(0, 240, 255, 0.22)';
            ctx.lineWidth = 1;
            ctx.fillRect(x, y, cs, cs);
            ctx.strokeRect(x, y, cs, cs);
          }
        }

        // 3. Static Segments & Motorized Rotors
        ctx.lineCap = 'round';
        for (let i = 0; i < world.segments.length; i++) {
          const s = world.segments[i];
          ctx.strokeStyle = s.color;
          ctx.lineWidth = s.thickness;
          ctx.beginPath();
          ctx.moveTo(s.x1, s.y1);
          ctx.lineTo(s.x2, s.y2);
          ctx.stroke();
        }

        for (let i = 0; i < world.rotors.length; i++) {
          const r = world.rotors[i];
          ctx.fillStyle = '#0f172a';
          ctx.strokeStyle = '#00f0ff';
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.arc(r.cx, r.cy, 12, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        }

        // 4. Render Standard Constraints & Ragdoll Rounded Anatomical Capsules
        const showStress = world.debug.showStressHeatmap;
        const showSkel = world.debug.showSkeleton;

        for (let i = 0; i < world.constraints.length; i++) {
          const c = world.constraints[i];
          if (c.broken) continue;

          // Internal Ragdoll Muscles (only drawn if Skeleton Debug is enabled)
          if (!c.visible && !showSkel) continue;

          let strokeColor = c.color || '#0ea5e9';
          if (showStress) {
            if (c.strain >= 0.62) strokeColor = '#f43f5e';
            else if (c.strain >= 0.28) strokeColor = '#f59e0b';
          }

          if (c.ragdollId && c.capsuleRadius > 0) {
            // Draw Cyber Mannequin Rounded Capsule Limb
            ctx.lineCap = 'round';
            ctx.strokeStyle = showStress && c.strain > 0.3 ? strokeColor : 'rgba(30, 41, 59, 0.92)';
            ctx.lineWidth = c.capsuleRadius * 2;
            ctx.beginPath();
            ctx.moveTo(c.p1.x, c.p1.y);
            ctx.lineTo(c.p2.x, c.p2.y);
            ctx.stroke();

            // Inner glowing bone core
            ctx.strokeStyle = strokeColor;
            ctx.lineWidth = Math.max(2, c.capsuleRadius * 0.48);
            ctx.beginPath();
            ctx.moveTo(c.p1.x, c.p1.y);
            ctx.lineTo(c.p2.x, c.p2.y);
            ctx.stroke();
          } else {
            ctx.lineWidth = c.visible ? 1.8 : 1.0;
            ctx.strokeStyle = c.visible ? strokeColor : 'rgba(148, 163, 184, 0.25)';
            ctx.beginPath();
            ctx.moveTo(c.p1.x, c.p1.y);
            ctx.lineTo(c.p2.x, c.p2.y);
            ctx.stroke();
          }
        }

        // 5. Render Particles, Bombs & Ragdoll Cyber Heads/Joints
        const particles = world.particles;
        const pLen = particles.length;
        const showVel = world.debug.showVelocity;

        for (let i = 0; i < pLen; i++) {
          const p = particles[i];
          if (!p.collideParticles && !p.pinned && pLen > 400) continue;

          if (p.label === 'head') {
            // Render Mannequin Cyber Helmet & Directional Visor
            ctx.fillStyle = '#0f172a';
            ctx.strokeStyle = '#00f0ff';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            // Glowing Cyber Visor Bar
            ctx.fillStyle = '#00f0ff';
            ctx.beginPath();
            ctx.arc(p.x, p.y - 2, p.radius * 0.55, 0, Math.PI * 2);
            ctx.fill();
          } else if (p.isBomb) {
            // Render Pulsing Timed Explosive Bomb
            const pulse = Math.sin(performance.now() * 0.025) > 0;
            ctx.fillStyle = pulse ? '#f43f5e' : '#1e293b';
            ctx.strokeStyle = '#f59e0b';
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 10px "JetBrains Mono", monospace';
            ctx.textAlign = 'center';
            ctx.fillText(p.bombTimer.toFixed(1) + 's', p.x, p.y + 3);
          } else {
            ctx.fillStyle = p.ragdollId ? '#0f172a' : p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fill();

            if (p.ragdollId) {
              ctx.strokeStyle = p.color;
              ctx.lineWidth = 1.8;
              ctx.stroke();
            }
          }

          // Pinned Anchor Ring Indicator
          if (p.pinned) {
            ctx.strokeStyle = '#00f0ff';
            ctx.lineWidth = 2.2;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius + 4, 0, Math.PI * 2);
            ctx.stroke();
          }

          if (showVel && !p.pinned) {
            const vx = (p.x - p.oldX) * 6;
            const vy = (p.y - p.oldY) * 6;
            if (vx * vx + vy * vy > 1) {
              ctx.strokeStyle = '#10b981';
              ctx.lineWidth = 1.3;
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(p.x + vx, p.y + vy);
              ctx.stroke();
            }
          }
        }

        // 6. Shockwave Rings & Sparks FX
        for (let i = 0; i < world.rings.length; i++) {
          const r = world.rings[i];
          ctx.strokeStyle = r.color;
          ctx.globalAlpha = Math.max(0, r.alpha);
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(r.x, r.y, r.radius, 0, Math.PI * 2);
          ctx.stroke();
        }

        for (let i = 0; i < world.sparks.length; i++) {
          const s = world.sparks[i];
          ctx.fillStyle = s.color;
          ctx.globalAlpha = Math.max(0, s.life / s.maxLife);
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1.0;

        // 7. Interactive Tool Overlays
        this._renderToolOverlays(ctx);
      },

      _renderToolOverlays(ctx) {
        const ptr = this.pointer;

        // Tool 1: Grab & Stretch Line + Newton Force Readout
        if (ptr.grabbedParticle) {
          const gp = ptr.grabbedParticle;
          ctx.strokeStyle = '#00f0ff';
          ctx.lineWidth = 2.2;
          ctx.setLineDash([5, 4]);
          ctx.beginPath();
          ctx.moveTo(gp.x, gp.y);
          ctx.lineTo(ptr.x, ptr.y);
          ctx.stroke();
          ctx.setLineDash([]);

          ctx.beginPath();
          ctx.arc(gp.x, gp.y, gp.radius + 5, 0, Math.PI * 2);
          ctx.strokeStyle = '#00f0ff';
          ctx.stroke();

          ctx.fillStyle = '#00f0ff';
          ctx.font = 'bold 11px "JetBrains Mono", monospace';
          ctx.fillText(`${this.world.metrics.pullForceNewtons} N  [E: Anclar]`, ptr.x + 14, ptr.y - 10);
        }

        // Tool 2: Laser Scalpel Beam
        if (ptr.isDown && ptr.tool === 'slice') {
          ctx.strokeStyle = '#f43f5e';
          ctx.lineWidth = 3.5;
          ctx.beginPath();
          ctx.moveTo(ptr.prevX, ptr.prevY);
          ctx.lineTo(ptr.x, ptr.y);
          ctx.stroke();
        }

        // Tool 3: Ballistic Cannon Trajectory Preview
        if (ptr.isDown && ptr.tool === 'cannon' && ptr.button === 0 && !ptr.shiftKey) {
          const dx = ptr.startX - ptr.x;
          const dy = ptr.startY - ptr.y;
          ctx.strokeStyle = '#f59e0b';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(ptr.startX, ptr.startY);
          ctx.lineTo(ptr.x, ptr.y);
          ctx.stroke();

          const vx = dx * 5.6;
          const vy = dy * 5.6;
          ctx.fillStyle = 'rgba(0, 240, 255, 0.75)';
          for (let step = 1; step <= 14; step++) {
            const t = step * 0.038;
            const px = ptr.startX + vx * t + 0.5 * this.world.params.gravityX * t * t;
            const py = ptr.startY + vy * t + 0.5 * this.world.params.gravityY * t * t;
            ctx.beginPath();
            ctx.arc(px, py, 2.6, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        // Tool 4: Gravity Vortex Singularity Rings
        if (ptr.isDown && ptr.tool === 'vortex') {
          const isRepel = ptr.shiftKey || ptr.button === 2;
          ctx.strokeStyle = isRepel ? 'rgba(244, 63, 94, 0.7)' : 'rgba(139, 92, 246, 0.8)';
          ctx.lineWidth = 2;
          for (let r = 18; r <= 96; r += 24) {
            ctx.beginPath();
            ctx.arc(ptr.x, ptr.y, r + ((performance.now() * 0.06) % 20), 0, Math.PI * 2);
            ctx.stroke();
          }
        }

        // Tool 5: Spinning Grinder Saw Blade Overlay (Always visible when tool 5 is active)
        if (ptr.tool === 'grinder') {
          const sawR = 46;
          const teeth = 14;
          const baseAng = performance.now() * (ptr.isDown ? 0.022 : 0.006);

          ctx.save();
          ctx.translate(ptr.x, ptr.y);
          ctx.rotate(baseAng);

          ctx.beginPath();
          for (let i = 0; i < teeth * 2; i++) {
            const r = i % 2 === 0 ? sawR : sawR - 9;
            const a = (i * Math.PI) / teeth;
            const tx = Math.cos(a) * r;
            const ty = Math.sin(a) * r;
            if (i === 0) ctx.moveTo(tx, ty);
            else ctx.lineTo(tx, ty);
          }
          ctx.closePath();
          ctx.fillStyle = ptr.isDown ? 'rgba(244, 63, 94, 0.28)' : 'rgba(148, 163, 184, 0.15)';
          ctx.strokeStyle = ptr.isDown ? '#f43f5e' : '#00f0ff';
          ctx.lineWidth = 2;
          ctx.fill();
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(0, 0, 10, 0, Math.PI * 2);
          ctx.strokeStyle = '#f59e0b';
          ctx.stroke();
          ctx.restore();
        }

        // Tool 6: Rope & Spring Welder Preview Line
        if (ptr.isDown && ptr.tool === 'welder' && ptr.weldStartNode) {
          ctx.strokeStyle = '#f59e0b';
          ctx.lineWidth = 2.4;
          ctx.setLineDash([6, 4]);
          ctx.beginPath();
          ctx.moveTo(ptr.weldStartNode.x, ptr.weldStartNode.y);
          ctx.lineTo(ptr.x, ptr.y);
          ctx.stroke();
          ctx.setLineDash([]);
        }
      },

      /**
       * UI & SCENARIO CONTROLS
       */
      loadScenario(name) {
        this.currentScenario = name;
        this.pointer.grabbedParticle = null;
        this.pointer.weldStartNode = null;

        document.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('active'));
        const activeBtn = document.getElementById(`preset-${name}`);
        if (activeBtn) activeBtn.classList.add('active');

        if (name === 'ragdoll') ScenarioBuilder.buildRagdollLab(this.world);
        else if (name === 'bridge') ScenarioBuilder.buildSuspensionBridge(this.world);
        else if (name === 'avalanche') ScenarioBuilder.buildGranularAvalanche(this.world);
        else if (name === 'crusher') ScenarioBuilder.buildCrusherChamber(this.world);
        else if (name === 'softbody') ScenarioBuilder.buildSoftbodyDemolition(this.world);
        else if (name === 'cradle') ScenarioBuilder.buildNewtonsCradle(this.world);

        this._syncSlidersFromWorld();
      },

      resetCurrentScenario() {
        this.loadScenario(this.currentScenario);
      },

      setTool(toolName) {
        this.pointer.tool = toolName;
        this.pointer.grabbedParticle = null;
        this.pointer.weldStartNode = null;

        document.querySelectorAll('.tool-btn').forEach((b) => b.classList.remove('active'));
        const btn = document.getElementById(`tool-${toolName}`);
        if (btn) btn.classList.add('active');

        const labels = {
          grab: ['[1: AGARRAR / ESTIRAR]', 'Arrastra extremidades del maniquí. Pulsa [E] o [Espacio] mientras sujetas para ANCLARLO en el aire.'],
          slice: ['[2: BISTURÍ LÁSER TÉRMICO]', 'Traza un rayo láser sobre cuerdas, telas o articulaciones del maniquí para cortarlas.'],
          cannon: ['[3: CAÑÓN BALÍSTICO]', 'Arrastra y suelta para disparar proyectiles pesados (Mantén Shift para ametralladora).'],
          vortex: ['[4: VÓRTICE GRAVITATORIO]', 'Mantén clic para succionar y girar al maniquí (Mantén Shift + clic para repeler).'],
          grinder: ['[5: SIERRA CIRCULAR RPM]', 'Mantén clic para activar el disco dentado de alta velocidad y desgarrar estructuras.'],
          welder: ['[6: SOLDADOR DE CUERDAS]', 'Arrastra de una extremidad a otro punto (o al aire) para atar cables tensores.'],
          spawner: ['[7: INVOCADOR DE OBJETOS]', 'Haz clic en cualquier punto del escenario para spawnear un Maniquí, Bomba o Roca.']
        };

        document.getElementById('active-tool-indicator').textContent = labels[toolName][0];
        document.getElementById('active-tool-hint').textContent = labels[toolName][1];
      },

      setSpawnType(type) {
        this.spawnType = type;
        this.setTool('spawner');
        document.querySelectorAll('.spawn-type-btn').forEach((b) => b.classList.remove('active'));
        const btn = document.getElementById(`spawn-${type}`);
        if (btn) btn.classList.add('active');
      },

      setRagdollMode(mode) {
        RagdollFactory.applyModeToWorld(this.world, mode);
        document.querySelectorAll('.ragdoll-mode-btn').forEach((b) => b.classList.remove('active'));
        const btn = document.getElementById(`rmode-${mode}`);
        if (btn) btn.classList.add('active');

        const descriptions = {
          stretch: 'Modo Goma Elástica: Puedes estirar los brazos, piernas y torso del maniquí al extremo sin que se rompa.',
          firm: 'Modo Anatómico Firme: Proporciones humanas sólidas y articulaciones naturales resistentes.',
          destructible: 'Modo Desmembramiento Mortal: Si tiras con fuerza o impactas una articulación, se desmiembra con chispas.'
        };
        document.getElementById('ragdoll-mode-desc').textContent = descriptions[mode];
        this.showToast(`Modo del Maniquí: ${mode.toUpperCase()}`);
      },

      setBroadphase(mode) {
        this.world.broadphaseMode = mode;
        const btnGrid = document.getElementById('bp-grid');
        const btnNaive = document.getElementById('bp-naive');
        const badge = document.getElementById('broadphase-badge');

        if (mode === 'grid') {
          btnGrid.className = 'py-1.5 px-2 rounded-lg font-mono text-xs border border-emerald-500/60 bg-emerald-500/15 text-emerald-300 font-semibold transition';
          btnNaive.className = 'py-1.5 px-2 rounded-lg font-mono text-xs border border-slate-700 bg-slate-800/60 text-slate-400 hover:text-slate-200 transition';
          badge.textContent = 'O(N) ACTIVO';
          badge.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        } else {
          btnNaive.className = 'py-1.5 px-2 rounded-lg font-mono text-xs border border-rose-500/60 bg-rose-500/15 text-rose-300 font-semibold transition';
          btnGrid.className = 'py-1.5 px-2 rounded-lg font-mono text-xs border border-slate-700 bg-slate-800/60 text-slate-400 hover:text-slate-200 transition';
          badge.textContent = 'O(N²) FUERZA BRUTA';
          badge.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30';
        }
      },

      setGravityPreset(gx, gy) {
        document.getElementById('slider-gravx').value = gx;
        document.getElementById('slider-gravy').value = gy;
        this.updateParam('gravityX', gx);
        this.updateParam('gravityY', gy);
      },

      toggleSlowMo() {
        this.isSlowMo = !this.isSlowMo;
        const scale = this.isSlowMo ? 0.25 : 1.0;
        document.getElementById('slider-timescale').value = scale;
        this.updateParam('timeScale', scale);
        const btn = document.getElementById('btn-slowmo');
        btn.className = this.isSlowMo
          ? 'px-2 py-1.5 rounded-lg border border-amber-400 bg-amber-500/20 text-amber-300 font-mono text-[11px] font-bold transition'
          : 'px-2 py-1.5 rounded-lg border border-slate-700 bg-slate-800/80 hover:border-amber-400/60 text-slate-200 font-mono text-[11px] transition';
      },

      updateParam(key, rawValue) {
        const val = parseFloat(rawValue);
        this.world.params[key] = val;

        if (key === 'subSteps') document.getElementById('val-substeps').textContent = `${val} pasos`;
        else if (key === 'timeScale') document.getElementById('val-timescale').textContent = `${val.toFixed(2)}x`;
        else if (key === 'gravityY') document.getElementById('val-gravy').textContent = `${val}`;
        else if (key === 'gravityX') document.getElementById('val-gravx').textContent = `${val}`;
        else if (key === 'restitution') document.getElementById('val-restitution').textContent = val.toFixed(2);
        else if (key === 'tearMultiplier') document.getElementById('val-tear').textContent = `${val.toFixed(1)}x`;
      },

      toggleDebug(key, checked) {
        this.world.debug[key] = checked;
      },

      togglePause() {
        this.isPaused = !this.isPaused;
        document.getElementById('play-pause-icon').textContent = this.isPaused ? '▶' : '⏸';
      },

      _syncSlidersFromWorld() {
        const p = this.world.params;
        const d = this.world.debug;

        document.getElementById('slider-substeps').value = p.subSteps;
        this.updateParam('subSteps', p.subSteps);

        document.getElementById('slider-timescale').value = p.timeScale;
        this.updateParam('timeScale', p.timeScale);

        document.getElementById('slider-gravy').value = p.gravityY;
        this.updateParam('gravityY', p.gravityY);

        document.getElementById('slider-gravx').value = p.gravityX;
        this.updateParam('gravityX', p.gravityX);

        document.getElementById('slider-restitution').value = p.restitution;
        this.updateParam('restitution', p.restitution);

        document.getElementById('slider-tear').value = p.tearMultiplier;
        this.updateParam('tearMultiplier', p.tearMultiplier);

        document.getElementById('chk-grid').checked = d.showGrid;
        document.getElementById('chk-heatmap').checked = d.showStressHeatmap;
        document.getElementById('chk-skeleton').checked = d.showSkeleton;
        document.getElementById('chk-velocity').checked = d.showVelocity;
        document.getElementById('chk-wind').checked = d.turbulentWind;
      }
    };

    window.onload = function () {
      EngineApp.init();
    };
  </script>
</body>
</html>
