<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Aether2D v2.0 — Ultimate Physics Sandbox & Ragdoll Studio</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script>
    if (typeof tailwind !== 'undefined') {
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace'],
            }
          }
        }
      };
    }
  </script>
  <style>
    :root {
      --bg-deep: #06080e;
      --bg-panel: rgba(12, 16, 25, 0.94);
      --border-cyber: #1e293b;
      --cyan: #00f0ff;
      --emerald: #10b981;
      --amber: #f59e0b;
      --rose: #f43f5e;
      --violet: #8b5cf6;
    }
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    html, body {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      background-color: var(--bg-deep);
      color: #e2e8f0;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow: hidden;
    }
    .font-mono {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    /* Custom thin scrollbars */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #080b12;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #00f0ff;
    }
    /* Range sliders */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 5px;
      background: #1e293b;
      border-radius: 999px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #00f0ff;
      cursor: pointer;
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.8);
      transition: transform 0.1s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.22);
    }
    .cyber-panel {
      background: var(--bg-panel);
      backdrop-filter: blur(14px);
      border: 1px solid var(--border-cyber);
    }
    .tool-btn {
      transition: all 0.15s ease;
    }
    .tool-btn.active {
      background: rgba(0, 240, 255, 0.15);
      border-color: #00f0ff !important;
      color: #00f0ff;
      box-shadow: inset 0 0 14px rgba(0, 240, 255, 0.2), 0 0 10px rgba(0, 240, 255, 0.12);
    }
    .preset-btn.active {
      background: rgba(16, 185, 129, 0.16);
      border-color: #10b981 !important;
      color: #34d399;
      box-shadow: 0 0 12px rgba(16, 185, 129, 0.2);
    }
    .ragdoll-mode-btn.active {
      background: rgba(0, 240, 255, 0.18);
      border-color: #00f0ff !important;
      color: #ffffff;
    }
    .spawn-type-btn.active {
      background: rgba(245, 158, 11, 0.2);
      border-color: #f59e0b !important;
      color: #fbbf24;
    }
    /* Main menu overlay transitions & glow */
    #main-menu-overlay {
      transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.45s;
    }
    #main-menu-overlay.hidden-overlay {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    .cyber-glow-btn {
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.35), inset 0 0 15px rgba(255, 255, 255, 0.15);
      transition: all 0.2s ease;
    }
    .cyber-glow-btn:hover {
      transform: translateY(-2px) scale(1.01);
      box-shadow: 0 0 38px rgba(0, 240, 255, 0.65), inset 0 0 20px rgba(255, 255, 255, 0.25);
    }
    .download-glow-btn {
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.25);
      transition: all 0.2s ease;
    }
    .download-glow-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 32px rgba(16, 185, 129, 0.55);
    }
  </style>
</head>
<body class="h-screen w-screen flex flex-col font-sans antialiased select-none relative">

  <!-- =========================================================================
       1. PANTALLA PRINCIPAL DE INICIO (MAIN MENU OVERLAY)
       ========================================================================= -->
  <div id="main-menu-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-[#05070c]/95 overflow-y-auto p-4">
    <!-- Interactive Physics Background Canvas -->
    <canvas id="menu-bg-canvas" class="fixed inset-0 w-full h-full pointer-events-auto"></canvas>

    <!-- Radial Cyber Vignette -->
    <div class="fixed inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,transparent_10%,#04060a_90%)]"></div>

    <!-- Main Center Card -->
    <div class="relative z-10 max-w-4xl w-full cyber-panel rounded-2xl p-6 sm:p-10 border border-slate-700/80 shadow-[0_0_80px_rgba(0,240,255,0.12)] my-auto">
      <!-- Top Status Tag -->
      <div class="flex flex-wrap items-center justify-between gap-2 mb-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-400/40 text-cyan-300 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>AETHER-2D ENGINE // BUILD v2.0 PORTABLE</span>
        </div>
        <span class="text-xs font-mono text-slate-400">60 FPS DETERMINISTIC SUB-STEPPING &bull; ZERO EXTERNAL DEPS</span>
      </div>

      <!-- Main Hero Title -->
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-3 leading-tight">
        AETHER <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400">2D</span>
        <span class="block text-xl sm:text-2xl font-mono font-semibold text-slate-300 mt-1">
          // SANDBOX &amp; RAGDOLL ENGINE v2.0
        </span>
      </h1>

      <p class="text-sm sm:text-base text-slate-300 max-w-3xl mb-6 leading-relaxed">
        Estudio interactivo de simulación física en tiempo real con <strong class="text-cyan-300">Maniquíes Humanos Articulados (Crash-Test Ragdolls)</strong>, integración Verlet de sub-paso determinista, particionamiento espacial <span class="font-mono text-emerald-300">Spatial Hash Grid O(N)</span>, desmembramiento dinámico y 7 herramientas de laboratorio.
      </p>

      <!-- Feature Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-7">
        <div class="p-3.5 rounded-xl bg-slate-900/85 border border-slate-800 hover:border-cyan-500/50 transition">
          <div class="text-cyan-400 font-mono text-xs font-bold uppercase mb-1">01 // RAGDOLL LAB</div>
          <div class="text-sm font-semibold text-white mb-1">Maniquí Humano Sandbox</div>
          <p class="text-xs text-slate-400 leading-relaxed">Estíralo como goma elástica, clávalo en el aire con <span class="font-mono text-cyan-300">[E]</span> o activa el modo desmembramiento.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-900/85 border border-slate-800 hover:border-amber-500/50 transition">
          <div class="text-amber-400 font-mono text-xs font-bold uppercase mb-1">02 // ARSENAL ACTIVO</div>
          <div class="text-sm font-semibold text-white mb-1">7 Herramientas Físicas</div>
          <p class="text-xs text-slate-400 leading-relaxed">Agarre con medidor en Newtons, Bisturí Láser, Sierra Circular RPM, Soldador de Cuerdas, Cañón, Vórtice y Spawner.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-900/85 border border-slate-800 hover:border-emerald-500/50 transition">
          <div class="text-emerald-400 font-mono text-xs font-bold uppercase mb-1">03 // 6 ESCENARIOS</div>
          <div class="text-sm font-semibold text-white mb-1">Ingeniería &amp; Demolición</div>
          <p class="text-xs text-slate-400 leading-relaxed">Laboratorio Ragdoll, Puente Colgante, Avalancha 1400+, Trituradora Industrial, Softbody Jelly y Cuna de Newton.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-slate-900/85 border border-slate-800 hover:border-violet-500/50 transition">
          <div class="text-violet-400 font-mono text-xs font-bold uppercase mb-1">04 // PROFILER LIVE</div>
          <div class="text-sm font-semibold text-white mb-1">Telemetría &amp; Slow-Mo</div>
          <p class="text-xs text-slate-400 leading-relaxed">Osciloscopio de CPU/Render, comparativa <span class="font-mono text-emerald-300">O(N) vs O(N²)</span> en vivo, cámara lenta y mapa térmico.</p>
        </div>
      </div>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5">
        <button onclick="EngineApp.enterSandbox()" class="cyber-glow-btn flex-1 py-4 px-6 rounded-xl bg-gradient-to-r from-cyan-500 to-teal-400 text-slate-950 font-extrabold text-base sm:text-lg tracking-wide flex items-center justify-center gap-3 cursor-pointer">
          <span>▶ JUGAR / ENTRAR AL SANDBOX</span>
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-950/25 text-slate-950">ESCENARIO 1</span>
        </button>

        <button onclick="EngineApp.downloadPortableHTML()" class="download-glow-btn py-4 px-6 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-400/60 text-emerald-300 font-mono font-bold text-sm sm:text-base flex items-center justify-center gap-2.5 cursor-pointer">
          <span>⬇ DESCARGAR HTML (VERSIÓN PORTABLE)</span>
        </button>
      </div>

      <!-- Footer Hint -->
      <div class="mt-5 pt-4 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400 font-mono">
        <span>💡 Mueve el ratón por el fondo para interactuar con la malla física en tiempo real.</span>
        <span class="text-cyan-400">100% Autónomo &bull; Funciona Offline</span>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION FOR PORTABLE HTML DOWNLOAD & ACTIONS -->
  <div id="toast-notification" class="fixed bottom-5 right-5 z-50 pointer-events-none opacity-0 transition-all duration-300 transform translate-y-3 cyber-panel px-4 py-3 rounded-xl border border-emerald-400/60 shadow-2xl flex items-center gap-3">
    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
    <span id="toast-message" class="text-xs font-mono text-emerald-200 font-semibold">Archivo descargado correctamente</span>
  </div>

  <!-- =========================================================================
       TOP TELEMETRY, SCENARIOS & QUICK ACTIONS HEADER
       ========================================================================= -->
  <header class="h-14 cyber-panel border-b border-slate-800/90 px-3 flex items-center justify-between gap-2 z-20 shrink-0">
    <!-- Brand + Main Menu Button -->
    <div class="flex items-center gap-2.5 shrink-0">
      <button onclick="EngineApp.showMainMenu()" class="px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700 text-cyan-300 font-mono text-xs flex items-center gap-1.5 transition" title="Volver a la Pantalla Principal">
        <span>🏠</span>
        <span class="hidden md:inline">MENÚ</span>
      </button>

      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-cyan-500/10 border border-cyan-400/50 flex items-center justify-center">
          <span class="text-cyan-400 font-mono font-bold text-xs">A2D</span>
        </div>
        <div class="hidden xl:block">
          <div class="flex items-center gap-1.5">
            <span class="font-mono font-bold tracking-wider text-xs text-white">AETHER<span class="text-cyan-400">2D</span></span>
            <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">v2.0</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 6 Engineering & Ragdoll Scenarios -->
    <div class="flex items-center gap-1 overflow-x-auto py-1 no-scrollbar">
      <button id="preset-ragdoll" onclick="EngineApp.loadScenario('ragdoll')" class="preset-btn active text-[11px] font-medium px-2.5 py-1.5 rounded-lg border border-slate-700/80 bg-slate-900/70 hover:border-slate-500 transition flex items-center gap-1.5 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>1. Maniquí Sandbox</span>
      </button>
      <button id="preset-bridge" onclick="EngineApp.loadScenario('bridge')" class="preset-btn text-[11px] font-medium px-2.5 py-1.5 rounded-lg border border-slate-700/80 bg-slate-900/70 hover:border-slate-500 transition flex items-center gap-1.5 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>2. Puente &amp; Tela</span>
      </button>
      <button id="preset-avalanche" onclick="EngineApp.loadScenario('avalanche')" class="preset-btn text-[11px] font-medium px-2.5 py-1.5 rounded-lg border border-slate-700/80 bg-slate-900/70 hover:border-slate-500 transition flex items-center gap-1.5 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>3. Avalancha 1400+</span>
      </button>
      <button id="preset-crusher" onclick="EngineApp.loadScenario('crusher')" class="preset-btn text-[11px] font-medium px-2.5 py-1.5 rounded-lg border border-slate-700/80 bg-slate-900/70 hover:border-slate-500 transition flex items-center gap-1.5 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-rose-400"></span>
        <span>4. Trituradora &amp; Ragdolls</span>
      </button>
      <button id="preset-softbody" onclick="EngineApp.loadScenario('softbody')" class="preset-btn text-[11px] font-medium px-2.5 py-1.5 rounded-lg border border-slate-700/80 bg-slate-900/70 hover:border-slate-500 transition flex items-center gap-1.5 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-fuchsia-400"></span>
        <span>5. Softbody &amp; Demolición</span>
      </button>
      <button id="preset-cradle" onclick="EngineApp.loadScenario('cradle')" class="preset-btn text-[11px] font-medium px-2.5 py-1.5 rounded-lg border border-slate-700/80 bg-slate-900/70 hover:border-slate-500 transition flex items-center gap-1.5 whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-violet-400"></span>
        <span>6. Cuna de Newton</span>
      </button>
    </div>

    <!-- Playback, Spawn Ragdoll & Portable Download Controls -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button onclick="EngineApp.spawnExtraRagdoll()" class="px-2.5 py-1.5 rounded-lg border border-cyan-500/50 bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-200 font-mono text-[11px] font-semibold flex items-center gap-1 transition" title="Spawnear otro Maniquí Humano en el centro">
        <span>🧍+ MANIQUÍ</span>
      </button>

      <button id="btn-slowmo" onclick="EngineApp.toggleSlowMo()" class="px-2 py-1.5 rounded-lg border border-slate-700 bg-slate-800/80 hover:border-amber-400/60 text-slate-200 font-mono text-[11px] transition" title="Alternar Cámara Lenta (Slow-Mo 0.25x)">
        🐢 0.25x
      </button>

      <button id="btn-play-pause" onclick="EngineApp.togglePause()" class="px-2.5 py-1.5 rounded-lg border border-cyan-500/40 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 font-mono text-[11px] flex items-center gap-1 transition" title="Pausar / Reanudar (P)">
        <span id="play-pause-icon">⏸</span>
      </button>

      <button onclick="EngineApp.resetCurrentScenario()" class="px-2 py-1.5 rounded-lg border border-slate-700 bg-slate-800/80 hover:border-rose-400/60 hover:text-rose-300 text-slate-200 font-mono text-[11px] transition" title="Reiniciar Escenario (Tecla R)">
        ↺
      </button>

      <button onclick="EngineApp.downloadPortableHTML()" class="px-2.5 py-1.5 rounded-lg border border-emerald-500/50 bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 font-mono text-[11px] font-semibold flex items-center gap-1 transition" title="Descargar archivo HTML completo para usar sin conexión">
        <span>⬇ HTML</span>
      </button>
    </div>
  </header>

  <!-- =========================================================================
       MAIN WORKSPACE (SIDEBAR + INTERACTIVE SANDBOX CANVAS)
       ========================================================================= -->
  <div class="flex-1 flex overflow-hidden relative">

    <!-- LEFT SIDEBAR: 7 TOOLS, RAGDOLL ELASTICITY, SOLVER & BROADPHASE -->
    <aside class="w-80 lg:w-84 cyber-panel border-r border-slate-800/90 flex flex-col overflow-y-auto z-10 shrink-0 p-3.5 space-y-3.5">

      <!-- Section 1: Arsenal of 7 Interactive Tools -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-[11px] font-mono uppercase tracking-wider text-cyan-400 font-bold">Arsenal de 7 Herramientas</h2>
          <span class="text-[10px] font-mono text-slate-400">Teclas [1]–[7]</span>
        </div>

        <div class="grid grid-cols-2 gap-1.5">
          <!-- Tool 1: Grab, Stretch & Pin -->
          <button id="tool-grab" onclick="EngineApp.setTool('grab')" class="tool-btn active p-2 rounded-lg border border-slate-700/80 bg-slate-900/60 text-left flex flex-col gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold">✋ Agarrar / Anclar</span>
              <span class="text-[10px] font-mono opacity-70">[1]</span>
            </div>
            <span class="text-[10px] text-slate-400 leading-tight">Estira + Pulsa [E]/[Espacio] para clavar</span>
          </button>

          <!-- Tool 2: Thermal Laser Cutter -->
          <button id="tool-slice" onclick="EngineApp.setTool('slice')" class="tool-btn p-2 rounded-lg border border-slate-700/80 bg-slate-900/60 text-left flex flex-col gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold">⚡ Bisturí Láser</span>
              <span class="text-[10px] font-mono opacity-70">[2]</span>
            </div>
            <span class="text-[10px] text-slate-400 leading-tight">Corta cuerdas y desmiembra</span>
          </button>

          <!-- Tool 3: Ballistic Vector Cannon -->
          <button id="tool-cannon" onclick="EngineApp.setTool('cannon')" class="tool-btn p-2 rounded-lg border border-slate-700/80 bg-slate-900/60 text-left flex flex-col gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold">☄️ Cañón Balístico</span>
              <span class="text-[10px] font-mono opacity-70">[3]</span>
            </div>
            <span class="text-[10px] text-slate-400 leading-tight">Arrastra vector (Shift: Ráfaga)</span>
          </button>

          <!-- Tool 4: Gravity Vortex / Black Hole -->
          <button id="tool-vortex" onclick="EngineApp.setTool('vortex')" class="tool-btn p-2 rounded-lg border border-slate-700/80 bg-slate-900/60 text-left flex flex-col gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold">🌀 Vórtice / Agujero</span>
              <span class="text-[10px] font-mono opacity-70">[4]</span>
            </div>
            <span class="text-[10px] text-slate-400 leading-tight">Succiona y gira (Shift: Repele)</span>
          </button>

          <!-- Tool 5: Motorized Spinning Grinder Saw -->
          <button id="tool-grinder" onclick="EngineApp.setTool('grinder')" class="tool-btn p-2 rounded-lg border border-slate-700/80 bg-slate-900/60 text-left flex flex-col gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold">⚙️ Sierra Circular</span>
              <span class="text-[10px] font-mono opacity-70">[5]</span>
            </div>
            <span class="text-[10px] text-slate-400 leading-tight">Disco dentado a altas RPM</span>
          </button>

          <!-- Tool 6: Rope & Spring Welder -->
          <button id="tool-welder" onclick="EngineApp.setTool('welder')" class="tool-btn p-2 rounded-lg border border-slate-700/80 bg-slate-900/60 text-left flex flex-col gap-0.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold">🔗 Soldador Cuerdas</span>
              <span class="text-[10px] font-mono opacity-70">[6]</span>
            </div>
            <span class="text-[10px] text-slate-400 leading-tight">Une extremidades o ata al aire</span>
          </button>

          <!-- Tool 7: Multi-Spawner (Ragdoll / Bomb / Boulder) -->
          <button id="tool-spawner" onclick="EngineApp.setTool('spawner')" class="tool-btn col-span-2 p-2 rounded-lg border border-slate-700/80 bg-slate-900/60 text-left flex items-center justify-between">
            <div>
              <div class="text-xs font-semibold">📦 Invocador (Maniquí / Bomba / Roca)</div>
              <div class="text-[10px] text-slate-400">Haz clic en el canvas para generar objetos físicos</div>
            </div>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-cyan-300">[7]</span>
          </button>
        </div>

        <!-- Sub-Selector for Tool 7 (Spawner) -->
        <div id="spawner-subpanel" class="mt-2 p-2 rounded-lg bg-slate-900/90 border border-amber-500/40 space-y-1.5">
          <div class="text-[10px] font-mono uppercase text-amber-300 font-semibold">Objeto a Invocar (Tool 7):</div>
          <div class="grid grid-cols-3 gap-1">
            <button id="spawn-ragdoll" onclick="EngineApp.setSpawnType('ragdoll')" class="spawn-type-btn active py-1 px-1.5 rounded border border-slate-700 bg-slate-800/70 text-[11px] font-mono">
              🧍 Maniquí
            </button>
            <button id="spawn-bomb" onclick="EngineApp.setSpawnType('bomb')" class="spawn-type-btn py-1 px-1.5 rounded border border-slate-700 bg-slate-800/70 text-[11px] font-mono">
              💣 Bomba
            </button>
            <button id="spawn-rock" onclick="EngineApp.setSpawnType('rock')" class="spawn-type-btn py-1 px-1.5 rounded border border-slate-700 bg-slate-800/70 text-[11px] font-mono">
              🪨 Roca
            </button>
          </div>
        </div>
