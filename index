  <script>
    "use strict";

    /**
     * 1. SPATIAL HASH GRID FOR O(N) BROADPHASE COLLISION DETECTION
     */
    class SpatialHashGrid {
      constructor(cellSize = 28) {
        this.cellSize = cellSize;
        this.invCellSize = 1 / cellSize;
        this.cells = new Map();
        this.bucketPool = [];
        this.activeBuckets = [];
      }

      setCellSize(size) {
        this.cellSize = Math.max(14, Number(size));
        this.invCellSize = 1 / this.cellSize;
      }

      clear() {
        for (let i = 0; i < this.activeBuckets.length; i++) {
          const b = this.activeBuckets[i];
          b.items.length = 0;
          this.bucketPool.push(b);
        }
        this.activeBuckets.length = 0;
        this.cells.clear();
      }

      insert(particleIndex, x, y, radius) {
        const inv = this.invCellSize;
        const minX = Math.floor((x - radius) * inv);
        const maxX = Math.floor((x + radius) * inv);
        const minY = Math.floor((y - radius) * inv);
        const maxY = Math.floor((y + radius) * inv);

        for (let cy = minY; cy <= maxY; cy++) {
          for (let cx = minX; cx <= maxX; cx++) {
            const key = ((cx & 0xffff) << 16) | (cy & 0xffff);
            let bucket = this.cells.get(key);
            if (!bucket) {
              bucket = this.bucketPool.length > 0
                ? this.bucketPool.pop()
                : { cx, cy, items: [] };
              bucket.cx = cx;
              bucket.cy = cy;
              this.cells.set(key);
              this.cells.set(key, bucket);
              this.activeBuckets.push(bucket);
            }
            bucket.items.push(particleIndex);
          }
        }
      }
    }

    /**
     * 2. PARTICLE / RAGDOLL JOINT NODE
     */
    class Particle {
      constructor(x, y, radius = 6, mass = 1.0, pinned = false, color = '#38bdf8') {
        this.x = x;
        this.y = y;
        this.oldX = x;
        this.oldY = y;
        this.ax = 0;
        this.ay = 0;
        this.radius = radius;
        this.baseMass = mass > 0 ? mass : 1.0;
        this.mass = pinned ? 0 : this.baseMass;
        this.invMass = pinned ? 0 : 1 / this.baseMass;
        this.pinned = pinned;
        this.color = color;
        this.restitution = null;
        this.collideParticles = true;
        this.ragdollId = null; // Prevents self-collision jitter inside same ragdoll
        this.label = null;     // e.g. 'head', 'handL', 'footR'
        this.isBomb = false;
        this.bombTimer = 0;
      }

      setPinned(pinState) {
        this.pinned = pinState;
        if (pinState) {
          this.mass = 0;
          this.invMass = 0;
          this.oldX = this.x;
          this.oldY = this.y;
        } else {
          this.mass = this.baseMass;
          this.invMass = 1 / this.baseMass;
        }
      }

      setVelocity(vx, vy, dt) {
        this.oldX = this.x - vx * dt;
        this.oldY = this.y - vy * dt;
      }
    }

    /**
     * 3. DISTANCE CONSTRAINT (BONES, MUSCLES, ROPES, CLOTH, SPRINGS)
     */
    class DistanceConstraint {
      constructor(p1, p2, stiffness = 0.85, restLength = null, tearSensitivity = 1.0, visible = true, color = null) {
        this.p1 = p1;
        this.p2 = p2;
        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;
        this.restLength = restLength !== null ? restLength : Math.hypot(dx, dy);
        this.baseStiffness = stiffness;
        this.stiffness = stiffness;
        this.baseTearSensitivity = tearSensitivity;
        this.tearSensitivity = tearSensitivity;
        this.visible = visible;
        this.color = color;
        this.strain = 0;
        this.broken = false;
        // Ragdoll capsule metadata
        this.ragdollId = null;
        this.limbType = null; // 'torso', 'upperArm', 'forearm', 'thigh', 'calf', 'neck', 'shoulder', 'pelvis', 'muscle'
        this.capsuleRadius = 0;
      }
    }

    /**
     * 4. STATIC COLLISION SEGMENT & MOTORIZED KINEMATIC ROTORS
     */
    class StaticSegment {
      constructor(x1, y1, x2, y2, thickness = 8, color = '#334155') {
        this.x1 = x1;
        this.y1 = y1;
        this.x2 = x2;
        this.y2 = y2;
        this.thickness = thickness;
        this.color = color;
        this.tangentialSpeed = 0;
      }
    }

    class KinematicRotor {
      constructor(cx, cy, radius, numBlades = 4, angularSpeed = 2.8, thickness = 10, color = '#f59e0b') {
        this.cx = cx;
        this.cy = cy;
        this.radius = radius;
        this.numBlades = numBlades;
        this.angle = 0;
        this.angularSpeed = angularSpeed;
        this.thickness = thickness;
        this.color = color;
        this.segments = [];
        for (let i = 0; i < numBlades; i++) {
          this.segments.push(new StaticSegment(cx, cy, cx + radius, cy, thickness, color));
        }
      }

      update(dt) {
        this.angle += this.angularSpeed * dt;
        for (let i = 0; i < this.numBlades; i++) {
          const a = this.angle + (i * Math.PI * 2) / this.numBlades;
          const seg = this.segments[i];
          seg.x1 = this.cx;
          seg.y1 = this.cy;
          seg.x2 = this.cx + Math.cos(a) * this.radius;
          seg.y2 = this.cy + Math.sin(a) * this.radius;
          seg.tangentialSpeed = this.angularSpeed * this.radius * 0.5;
        }
      }
    }

    /**
     * 5. SPARK & EXPLOSION VISUAL FX
     */
    class SparkFX {
      constructor(x, y, vx, vy, color = '#00f0ff', life = 0.45, size = 2.4) {
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
        this.color = color;
        this.life = life;
        this.maxLife = life;
        this.size = size;
      }
    }

    class ShockwaveRingFX {
      constructor(x, y, maxRadius = 180, color = '#00f0ff') {
        this.x = x;
        this.y = y;
        this.radius = 8;
        this.maxRadius = maxRadius;
        this.color = color;
        this.alpha = 1.0;
      }
    }

    /**
     * 6. ARTICULATED HUMAN MANNEQUIN (CRASH-TEST RAGDOLL FACTORY)
     * Builds an anatomically proportioned humanoid with head, neck, shoulders, chest,
     * pelvis, elbows, hands, knees, ankles, structural bones and posture muscles.
     */
    let GLOBAL_RAGDOLL_COUNTER = 1;

    class RagdollFactory {
      static createHumanMannequin(world, cx, cy, scale = 1.0, mode = 'firm') {
        const ragdollId = GLOBAL_RAGDOLL_COUNTER++;
        const s = scale;

        const addNode = (ox, oy, r, mass, label, color = '#e2e8f0') => {
          const p = new Particle(cx + ox * s, cy + oy * s, r * s, mass, false, color);
          p.ragdollId = ragdollId;
          p.label = label;
          p.restitution = 0.35;
          return world.addParticle(p);
        };

        // 15 Anatomical Nodes for rich articulation & posture
        const head      = addNode(0, -82, 15, 2.4, 'head', '#00f0ff');
        const neck      = addNode(0, -58, 6, 1.4, 'neck', '#94a3b8');
        const chest     = addNode(0, -32, 11, 4.2, 'chest', '#38bdf8');
        const shoulderL = addNode(-19, -52, 7.5, 2.0, 'shoulderL', '#e2e8f0');
        const shoulderR = addNode(19, -52, 7.5, 2.0, 'shoulderR', '#e2e8f0');
        const pelvis    = addNode(0, 4, 11.5, 4.5, 'pelvis', '#38bdf8');
        const hipL      = addNode(-13, 8, 7.5, 2.2, 'hipL', '#e2e8f0');
        const hipR      = addNode(13, 8, 7.5, 2.2, 'hipR', '#e2e8f0');

        // Arms
        const elbowL    = addNode(-44, -26, 6.5, 1.5, 'elbowL', '#cbd5e1');
        const handL     = addNode(-64, 0, 7.0, 1.2, 'handL', '#00f0ff');
        const elbowR    = addNode(44, -26, 6.5, 1.5, 'elbowR', '#cbd5e1');
        const handR     = addNode(64, 0, 7.0, 1.2, 'handR', '#00f0ff');

        // Legs
        const kneeL     = addNode(-16, 48, 7.5, 2.2, 'kneeL', '#cbd5e1');
        const footL     = addNode(-19, 92, 8.0, 1.8, 'footL', '#f59e0b');
        const kneeR     = addNode(16, 48, 7.5, 2.2, 'kneeR', '#cbd5e1');
        const footR     = addNode(19, 92, 8.0, 1.8, 'footR', '#f59e0b');

        const addBone = (p1, p2, limbType, capsuleRadius, stiff = 0.95, tearSens = 2.8) => {
          const c = new DistanceConstraint(p1, p2, stiff, null, tearSens, true, '#38bdf8');
          c.ragdollId = ragdollId;
          c.limbType = limbType;
          c.capsuleRadius = capsuleRadius * s;
          return world.addConstraint(c);
        };

        const addMuscle = (p1, p2, stiff = 0.32, tearSens = 2.2) => {
          const c = new DistanceConstraint(p1, p2, stiff, null, tearSens, false, '#64748b');
          c.ragdollId = ragdollId;
          c.limbType = 'muscle';
          return world.addConstraint(c);
        };

        // Primary Structural Skeleton Bones (Rendered as Cyber Capsules)
        addBone(head, neck, 'neck', 7);
        addBone(neck, chest, 'spineUpper', 10);
        addBone(chest, pelvis, 'torso', 13);
        addBone(neck, shoulderL, 'clavicle', 7);
        addBone(neck, shoulderR, 'clavicle', 7);
        addBone(shoulderL, shoulderR, 'shoulderBar', 6);
        addBone(shoulderL, chest, 'ribL', 7);
        addBone(shoulderR, chest, 'ribR', 7);

        addBone(pelvis, hipL, 'pelvisBar', 8);
        addBone(pelvis, hipR, 'pelvisBar', 8);
        addBone(hipL, hipR, 'pelvisSpan', 7);
        addBone(chest, hipL, 'coreL', 7);
        addBone(chest, hipR, 'coreR', 7);

        // Left & Right Arms
        addBone(shoulderL, elbowL, 'upperArm', 7.5);
        addBone(elbowL, handL, 'forearm', 6.5);
        addBone(shoulderR, elbowR, 'upperArm', 7.5);
        addBone(elbowR, handR, 'forearm', 6.5);

        // Left & Right Legs
        addBone(hipL, kneeL, 'thigh', 9.0);
        addBone(kneeL, footL, 'calf', 7.5);
        addBone(hipR, kneeR, 'thigh', 9.0);
        addBone(kneeR, footR, 'calf', 7.5);

        // Internal Posture & Joint Limit Muscles (Keeps human silhouette natural)
        addMuscle(head, chest, 0.45, 2.2);
        addMuscle(head, shoulderL, 0.35, 2.2);
        addMuscle(head, shoulderR, 0.35, 2.2);
        addMuscle(shoulderL, hipL, 0.55, 2.5);
        addMuscle(shoulderR, hipR, 0.55, 2.5);
        addMuscle(shoulderL, pelvis, 0.48, 2.5);
        addMuscle(shoulderR, pelvis, 0.48, 2.5);

        // Arm & Leg anti-collapse flexors
        addMuscle(shoulderL, handL, 0.14, 2.2);
        addMuscle(shoulderR, handR, 0.14, 2.2);
        addMuscle(hipL, footL, 0.20, 2.2);
        addMuscle(hipR, footR, 0.20, 2.2);
        addMuscle(pelvis, kneeL, 0.28, 2.2);
        addMuscle(pelvis, kneeR, 0.28, 2.2);
        addMuscle(kneeL, kneeR, 0.15, 2.0);

        const ragdollMeta = {
          id: ragdollId,
          head,
          neck,
          chest,
          pelvis,
          shoulderL,
          shoulderR,
          handL,
          handR,
          footL,
          footR
        };
        world.ragdolls.push(ragdollMeta);
        RagdollFactory.applyModeToWorld(world, mode);
        return ragdollMeta;
      }

      /**
       * Dynamically switches all Ragdoll joints between:
       * - 'stretch' (Rubber-man extreme elasticity without breaking)
       * - 'firm' (Anatomical crash-test proportions)
       * - 'destructible' (Mortal dismemberment when joints exceed tension threshold)
       */
      static applyModeToWorld(world, mode) {
        world.ragdollMode = mode;
        for (let i = 0; i < world.constraints.length; i++) {
          const c = world.constraints[i];
          if (!c.ragdollId) continue;

          if (mode === 'stretch') {
            // Elastic Rubber Mode: soft springy bones, virtually unbreakable
            c.stiffness = c.limbType === 'muscle' ? 0.08 : 0.22;
            c.tearSensitivity = 999.0;
          } else if (mode === 'firm') {
            // Firm Anatomical Mode: crisp human proportions, very high tear resistance
            c.stiffness = c.limbType === 'muscle' ? 0.35 : 0.96;
            c.tearSensitivity = 8.5;
          } else if (mode === 'destructible') {
            // Destructible Dismemberment Mode: realistic bone stiffness, breaks under high impulse/pull
            c.stiffness = c.limbType === 'muscle' ? 0.30 : 0.92;
            c.tearSensitivity = c.limbType === 'muscle' ? 0.62 : 0.78;
          }
        }
      }
    }

    /**
     * 7. CORE AETHER-2D v2.0 PHYSICS SOLVER
     */
    class AetherPhysicsWorld {
      constructor(width, height) {
        this.width = width;
        this.height = height;

        this.particles = [];
        this.constraints = [];
        this.segments = [];
        this.rotors = [];
        this.ragdolls = [];
        this.sparks = [];
        this.rings = [];

        this.spatialGrid = new SpatialHashGrid(28);
        this.broadphaseMode = 'grid';
        this.ragdollMode = 'firm'; // 'stretch' | 'firm' | 'destructible'

        this.params = {
          subSteps: 10,
          timeScale: 1.0,
          gravityX: 0,
          gravityY: 980,
          restitution: 0.50,
          stiffness: 0.90,
          tearMultiplier: 3.4,
          airDrag: 0.002,
          cellSize: 28
        };

        this.debug = {
          showGrid: false,
          showStressHeatmap: true,
          showSkeleton: false,
          showVelocity: false,
          turbulentWind: false,
          breakableConstraints: true
        };

        this.metrics = {
          broadphaseChecks: 0,
          narrowphaseContacts: 0,
          physicsStepMs: 0,
          renderMs: 0,
          pullForceNewtons: 0
        };

        this.simTime = 0;
      }

      clear() {
        this.particles.length = 0;
        this.constraints.length = 0;
        this.segments.length = 0;
        this.rotors.length = 0;
        this.ragdolls.length = 0;
        this.sparks.length = 0;
        this.rings.length = 0;
        this.spatialGrid.clear();
      }

      addParticle(p) {
        this.particles.push(p);
        return p;
      }

      addConstraint(c) {
        this.constraints.push(c);
        return c;
      }

      addSegment(s) {
        this.segments.push(s);
        return s;
      }

      addRotor(r) {
        this.rotors.push(r);
        for (let i = 0; i < r.segments.length; i++) {
          this.segments.push(r.segments[i]);
        }
        return r;
      }

      spawnSparks(x, y, count = 10, color = '#00f0ff', speed = 260) {
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const mag = (0.25 + Math.random() * 0.75) * speed;
          this.sparks.push(
            new SparkFX(
              x,
              y,
              Math.cos(angle) * mag,
              Math.sin(angle) * mag,
              color,
              0.22 + Math.random() * 0.38,
              1.8 + Math.random() * 1.8
            )
          );
        }
      }

      step(fixedDt, pointerState) {
        const t0 = performance.now();
        this.metrics.broadphaseChecks = 0;
        this.metrics.narrowphaseContacts = 0;
        this.metrics.pullForceNewtons = 0;

        const subSteps = this.params.subSteps;
        const scaledDt = fixedDt * this.params.timeScale;
        const subDt = scaledDt / subSteps;
        this.simTime += scaledDt;

        // Update motorized rotors
        for (let i = 0; i < this.rotors.length; i++) {
          this.rotors[i].update(scaledDt);
        }

        // Update timed bombs
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          if (p.isBomb) {
            p.bombTimer -= scaledDt;
            if (p.bombTimer <= 0) {
              const bx = p.x;
              const by = p.y;
              this.particles.splice(i, 1);
              this.detonateExplosion(bx, by, 230, 32);
            }
          }
        }

        for (let step = 0; step < subSteps; step++) {
          this._applyInteractiveForces(pointerState, subDt);
          this._integrateVerlet(subDt);
          this._solveConstraints();
          this._solveStaticSegments();
          this._solveParticleCollisions();
          this._solveWorldBoundaries();
        }

        // Clean up broken constraints & emit sparks at fracture point
        for (let i = this.constraints.length - 1; i >= 0; i--) {
          if (this.constraints[i].broken) {
            const c = this.constraints[i];
            const mx = (c.p1.x + c.p2.x) * 0.5;
            const my = (c.p1.y + c.p2.y) * 0.5;
            this.spawnSparks(mx, my, c.ragdollId ? 9 : 4, c.ragdollId ? '#f43f5e' : '#f59e0b', 200);
            this.constraints.splice(i, 1);
          }
        }

        // Update visual sparks & shockwave rings
        for (let i = this.sparks.length - 1; i >= 0; i--) {
          const s = this.sparks[i];
          s.x += s.vx * fixedDt;
          s.y += s.vy * fixedDt;
          s.vy += 420 * fixedDt;
          s.life -= fixedDt;
          if (s.life <= 0) this.sparks.splice(i, 1);
        }

        for (let i = this.rings.length - 1; i >= 0; i--) {
          const r = this.rings[i];
          r.radius += (r.maxRadius - r.radius) * 0.22;
          r.alpha -= fixedDt * 2.6;
          if (r.alpha <= 0) this.rings.splice(i, 1);
        }

        this.metrics.physicsStepMs = performance.now() - t0;
      }

      _applyInteractiveForces(pointer, subDt) {
        const particles = this.particles;
        const n = particles.length;
        const gx = this.params.gravityX;
        const gy = this.params.gravityY;
        const windActive = this.debug.turbulentWind;
        const t = this.simTime;

        for (let i = 0; i < n; i++) {
          const p = particles[i];
          if (p.pinned) continue;

          p.ax = gx;
          p.ay = gy;

          if (windActive) {
            const wave =
              Math.sin(t * 3.4 + p.y * 0.016) * 720 +
              Math.cos(t * 6.2 + p.x * 0.012) * 350 +
              480;
            const uplift = Math.sin(t * 4.2 + p.x * 0.02) * 240;
            p.ax += wave * p.invMass;
            p.ay += uplift * p.invMass;
          }
        }

        // Tool 1: Grab & Stretch with High-Power Spring & Force Measurement
        if (pointer.grabbedParticle) {
          const gp = pointer.grabbedParticle;
          const dx = pointer.x - gp.x;
          const dy = pointer.y - gp.y;
          const dist = Math.hypot(dx, dy);
          this.metrics.pullForceNewtons = Math.round(dist * 4.8);

          if (gp.pinned) {
            gp.x = pointer.x;
            gp.y = pointer.y;
            gp.oldX = pointer.x;
            gp.oldY = pointer.y;
          } else {
            gp.x += dx * 0.42;
            gp.y += dy * 0.42;
            gp.oldX = gp.x - (pointer.x - pointer.prevX) * 0.28;
            gp.oldY = gp.y - (pointer.y - pointer.prevY) * 0.28;
          }
        }

        // Tool 4: Gravity Vortex / Black Hole (Shift or Right-Click repels)
        if (pointer.isDown && pointer.tool === 'vortex') {
          const sign = (pointer.shiftKey || pointer.button === 2) ? -1 : 1;
          const maxRadius = 380;
          const strength = 2800000 * sign;

          for (let i = 0; i < n; i++) {
            const p = particles[i];
            if (p.pinned) continue;
            const dx = pointer.x - p.x;
            const dy = pointer.y - p.y;
            const distSq = dx * dx + dy * dy;
            if (distSq < maxRadius * maxRadius && distSq > 4) {
              const dist = Math.sqrt(distSq);
              const nx = dx / dist;
              const ny = dy / dist;
              const force = strength / Math.max(distSq, 1300);
              p.ax += nx * force - ny * force * 0.24;
              p.ay += ny * force + nx * force * 0.24;
            }
          }
        }

        // Tool 5: Motorized Spinning Grinder Saw (High-RPM toothed disc)
        if (pointer.isDown && pointer.tool === 'grinder') {
          const sawRadius = 46;
          const gxPos = pointer.x;
          const gyPos = pointer.y;

          // Slice any constraints touching the saw perimeter
          for (let i = 0; i < this.constraints.length; i++) {
            const c = this.constraints[i];
            if (c.broken) continue;
            const mx = (c.p1.x + c.p2.x) * 0.5;
            const my = (c.p1.y + c.p2.y) * 0.5;
            const dSq = (mx - gxPos) * (mx - gxPos) + (my - gyPos) * (my - gyPos);
            if (dSq < sawRadius * sawRadius) {
              // In destructible or cloth mode, sever immediately; in stretch/firm mode, sever non-ragdoll or apply heavy tear
              if (!c.ragdollId || this.ragdollMode === 'destructible') {
                c.broken = true;
              }
            }
          }

          // Impart violent tangential RPM velocity + radial kick to particles contacting the saw blade
          for (let i = 0; i < n; i++) {
            const p = particles[i];
            if (p.pinned) continue;
            const dx = p.x - gxPos;
            const dy = p.y - gyPos;
            const distSq = dx * dx + dy * dy;
            const minDist = sawRadius + p.radius;
            if (distSq < minDist * minDist && distSq > 0.001) {
              const dist = Math.sqrt(distSq);
              const nx = dx / dist;
              const ny = dy / dist;
              const overlap = minDist - dist;
              p.x += nx * overlap;
              p.y += ny * overlap;

              // Tangential vector (-ny, nx)
              const tx = -ny;
              const ty = nx;
              const kick = 14.5;
              p.oldX = p.x - (tx * kick + nx * 6);
              p.oldY = p.y - (ty * kick + ny * 6);

              if (Math.random() < 0.25) {
                this.spawnSparks(p.x, p.y, 2, '#f59e0b', 310);
              }
            }
          }
        }
      }

      _integrateVerlet(dt) {
        const particles = this.particles;
        const n = particles.length;
        const dtSq = dt * dt;
        const drag = Math.pow(1 - this.params.airDrag, 1 / this.params.subSteps);

        for (let i = 0; i < n; i++) {
          const p = particles[i];
          if (p.pinned) {
            p.oldX = p.x;
            p.oldY = p.y;
            continue;
          }

          const vx = (p.x - p.oldX) * drag;
          const vy = (p.y - p.oldY) * drag;

          p.oldX = p.x;
          p.oldY = p.y;

          p.x += vx + p.ax * dtSq;
          p.y += vy + p.ay * dtSq;
        }
      }

      _solveConstraints() {
        const constraints = this.constraints;
        const len = constraints.length;
        const globalStiff = this.params.stiffness;
        const tearLimit = this.params.tearMultiplier;
        const canBreak = this.debug.breakableConstraints;

        for (let i = 0; i < len; i++) {
          const c = constraints[i];
          if (c.broken) continue;

          const p1 = c.p1;
          const p2 = c.p2;
          const w1 = p1.invMass;
          const w2 = p2.invMass;
          const wSum = w1 + w2;
          if (wSum === 0) continue;

          const dx = p2.x - p1.x;
          const dy = p2.y - p1.y;
          const dist = Math.sqrt(dx * dx + dy * dy) || 0.0001;

          const diff = (dist - c.restLength) / dist;
          const stretchRatio = dist / Math.max(c.restLength, 1);

          const effectiveTear = tearLimit * c.tearSensitivity;
          c.strain = Math.max(0, Math.min(1, (stretchRatio - 1) / Math.max(effectiveTear - 1, 0.25)));

          if (canBreak && stretchRatio > effectiveTear) {
            c.broken = true;
            continue;
          }

          const stiff = c.stiffness * globalStiff;
          const corrX = dx * diff * stiff;
          const corrY = dy * diff * stiff;

          if (!p1.pinned) {
            const r1 = w1 / wSum;
            p1.x += corrX * r1;
            p1.y += corrY * r1;
          }
          if (!p2.pinned) {
            const r2 = w2 / wSum;
            p2.x -= corrX * r2;
            p2.y -= corrY * r2;
          }
        }
      }

      _solveStaticSegments() {
        const segments = this.segments;
        const sLen = segments.length;
        if (sLen === 0) return;

        const particles = this.particles;
        const pLen = particles.length;
        const globalRest = this.params.restitution;

        for (let i = 0; i < pLen; i++) {
          const p = particles[i];
          if (p.pinned) continue;

          for (let j = 0; j < sLen; j++) {
            const s = segments[j];
            const abx = s.x2 - s.x1;
            const aby = s.y2 - s.y1;
            const apx = p.x - s.x1;
            const apy = p.y - s.y1;
            const abLenSq = abx * abx + aby * aby;
            let t = (apx * abx + apy * aby) / abLenSq;
            if (t < 0) t = 0;
            else if (t > 1) t = 1;

            const closestX = s.x1 + abx * t;
            const closestY = s.y1 + aby * t;

            const dx = p.x - closestX;
            const dy = p.y - closestY;
            const distSq = dx * dx + dy * dy;
            const minDist = p.radius + s.thickness * 0.5;

            if (distSq < minDist * minDist && distSq > 0.000001) {
              const dist = Math.sqrt(distSq);
              const nx = dx / dist;
              const ny = dy / dist;
              const overlap = minDist - dist;

              const vx = p.x - p.oldX;
              const vy = p.y - p.oldY;

              p.x += nx * overlap;
              p.y += ny * overlap;

              const vn = vx * nx + vy * ny;
              if (vn < 0) {
                const e = p.restitution !== null ? p.restitution : globalRest;
                const tx = -ny;
                const ty = nx;
                const rotorKick = s.tangentialSpeed ? s.tangentialSpeed * 0.015 * t : 0;
                const vt = (vx * tx + vy * ty) * 0.94 + rotorKick;
                const newVn = -vn * e;

                p.oldX = p.x - (nx * newVn + tx * vt);
                p.oldY = p.y - (ny * newVn + ty * vt);
              }
            }
          }
        }
      }

      _solveParticleCollisions() {
        const particles = this.particles;
        const n = particles.length;
        if (n < 2) return;

        if (this.broadphaseMode === 'naive') {
          for (let i = 0; i < n; i++) {
            const p1 = particles[i];
            if (!p1.collideParticles) continue;
            for (let j = i + 1; j < n; j++) {
              const p2 = particles[j];
              if (!p2.collideParticles) continue;
              if (p1.ragdollId && p1.ragdollId === p2.ragdollId) continue;
              this.metrics.broadphaseChecks++;
              this._resolvePair(p1, p2);
            }
          }
        } else {
          this.spatialGrid.setCellSize(this.params.cellSize);
          this.spatialGrid.clear();

          for (let i = 0; i < n; i++) {
            const p = particles[i];
            if (p.collideParticles) {
              this.spatialGrid.insert(i, p.x, p.y, p.radius);
            }
          }

          const buckets = this.spatialGrid.activeBuckets;
          const bLen = buckets.length;

          for (let b = 0; b < bLen; b++) {
            const items = buckets[b].items;
            const count = items.length;
            if (count < 2) continue;

            for (let i = 0; i < count; i++) {
              const p1 = particles[items[i]];
              for (let j = i + 1; j < count; j++) {
                const p2 = particles[items[j]];
                if (p1.ragdollId && p1.ragdollId === p2.ragdollId) continue;
                this.metrics.broadphaseChecks++;
                this._resolvePair(p1, p2);
              }
            }
          }
        }
      }

      _resolvePair(p1, p2) {
        const w1 = p1.invMass;
        const w2 = p2.invMass;
        const wSum = w1 + w2;
        if (wSum === 0) return;

        const dx = p2.x - p1.x;
        const dy = p2.y - p1.y;
        const minDist = p1.radius + p2.radius;

        if (Math.abs(dx) >= minDist || Math.abs(dy) >= minDist) return;

        const distSq = dx * dx + dy * dy;
        if (distSq >= minDist * minDist || distSq < 0.00001) return;

        this.metrics.narrowphaseContacts++;

        const dist = Math.sqrt(distSq);
        const nx = dx / dist;
        const ny = dy / dist;
        const overlap = minDist - dist;

        const v1x = p1.x - p1.oldX;
        const v1y = p1.y - p1.oldY;
        const v2x = p2.x - p2.oldX;
        const v2y = p2.y - p2.oldY;

        const corr = overlap * 0.85;
        if (!p1.pinned) {
          const r1 = w1 / wSum;
          p1.x -= nx * corr * r1;
          p1.y -= ny * corr * r1;
        }
        if (!p2.pinned) {
          const r2 = w2 / wSum;
          p2.x += nx * corr * r2;
          p2.y += ny * corr * r2;
        }

        const rvx = v2x - v1x;
        const rvy = v2y - v1y;
        const velAlongNormal = rvx * nx + rvy * ny;

        if (velAlongNormal < 0) {
          const e1 = p1.restitution !== null ? p1.restitution : this.params.restitution;
          const e2 = p2.restitution !== null ? p2.restitution : this.params.restitution;
          const e = Math.min(e1, e2);

          const j = (-(1 + e) * velAlongNormal) / wSum;
          const impX = nx * j;
          const impY = ny * j;

          if (!p1.pinned) {
            p1.oldX = p1.x - (v1x - impX * w1);
            p1.oldY = p1.y - (v1y - impY * w1);
          }
          if (!p2.pinned) {
            p2.oldX = p2.x - (v2x + impX * w2);
            p2.oldY = p2.y - (v2y + impY * w2);
          }
        }
      }

      _solveWorldBoundaries() {
        const particles = this.particles;
        const n = particles.length;
        const w = this.width;
        const h = this.height;
        const globalRest = this.params.restitution;
        const wallFriction = 0.94;

        for (let i = 0; i < n; i++) {
          const p = particles[i];
          if (p.pinned) continue;

          const r = p.radius;
          const e = p.restitution !== null ? p.restitution : globalRest;
          const vx = p.x - p.oldX;
          const vy = p.y - p.oldY;

          if (p.y > h - r) {
            p.y = h - r;
            p.oldY = p.y + vy * e;
            p.oldX = p.x - vx * wallFriction;
          } else if (p.y < r) {
            p.y = r;
            p.oldY = p.y + vy * e;
          }

          if (p.x > w - r) {
            p.x = w - r;
            p.oldX = p.x + vx * e;
          } else if (p.x < r) {
            p.x = r;
            p.oldX = p.x + vx * e;
          }
        }
      }

      sliceConstraints(x1, y1, x2, y2) {
        let severedCount = 0;
        for (let i = 0; i < this.constraints.length; i++) {
          const c = this.constraints[i];
          if (c.broken) continue;

          if (this._segmentsIntersect(x1, y1, x2, y2, c.p1.x, c.p1.y, c.p2.x, c.p2.y)) {
            c.broken = true;
            severedCount++;
            const mx = (c.p1.x + c.p2.x) * 0.5;
            const my = (c.p1.y + c.p2.y) * 0.5;
            this.spawnSparks(mx, my, 7, '#00f0ff', 250);
          }
        }
        return severedCount;
      }

      detonateExplosion(cx, cy, radius = 210, impulse = 24) {
        this.rings.push(new ShockwaveRingFX(cx, cy, radius, '#f59e0b'));
        this.spawnSparks(cx, cy, 34, '#f59e0b', 420);
        this.spawnSparks(cx, cy, 18, '#f43f5e', 280);

        // Sever nearby destructible constraints
        for (let i = 0; i < this.constraints.length; i++) {
          const c = this.constraints[i];
          if (c.broken) continue;
          const mx = (c.p1.x + c.p2.x) * 0.5;
          const my = (c.p1.y + c.p2.y) * 0.5;
          const dist = Math.hypot(mx - cx, my - cy);
          if (dist < radius * 0.55 && (!c.ragdollId || this.ragdollMode === 'destructible')) {
            c.broken = true;
          }
        }

        for (let i = 0; i < this.particles.length; i++) {
          const p = this.particles[i];
          if (p.pinned) continue;
          const dx = p.x - cx;
          const dy = p.y - cy;
          const dist = Math.hypot(dx, dy);
          if (dist < radius && dist > 0.001) {
            const falloff = 1 - dist / radius;
            const push = impulse * falloff;
            p.oldX -= (dx / dist) * push;
            p.oldY -= (dy / dist) * push;
          }
        }
      }

      _segmentsIntersect(ax, ay, bx, by, cx, cy, dx, dy) {
        const ccw = (p1x, p1y, p2x, p2y, p3x, p3y) =>
          (p3y - p1y) * (p2x - p1x) > (p2y - p1y) * (p3x - p1x);
        return (
          ccw(ax, ay, cx, cy, dx, dy) !== ccw(bx, by, cx, cy, dx, dy) &&
          ccw(ax, ay, bx, by, cx, cy) !== ccw(ax, ay, bx, by, dx, dy)
        );
